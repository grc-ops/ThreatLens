# Copy to .env and fill in what you have. Sources without a key are skipped
# (their pages are still linked from every result).

# VirusTotal  https://www.virustotal.com/gui/my-apikey   (free: 4 req/min, 500/day)
VT_API_KEY=
# AbuseIPDB   https://www.abuseipdb.com/account/api      (free: 1000 checks/day)
ABUSEIPDB_API_KEY=
# AlienVault OTX  https://otx.alienvault.com/settings    (free)
OTX_API_KEY=
# GreyNoise Community  https://viz.greynoise.io/account/api-key  (free)
GREYNOISE_API_KEY=
# abuse.ch Auth-Key, one key covers URLhaus + ThreatFox + MalwareBazaar  https://auth.abuse.ch/
ABUSECH_API_KEY=
# Pulsedive   https://pulsedive.com/account            (free)
PULSEDIVE_API_KEY=

# Optional: higher limits only
URLSCAN_API_KEY=
NVD_API_KEY=

# No-key sources always on: Shodan InternetDB, CIRCL hashlookup, FIRST EPSS, CISA KEV, urlscan (anonymous)

# Tuning
VT_RPM=4            # raise to 500+ if you have a premium VT key
VT_DAILY=500        # shown in the health table; match your VirusTotal quota
ABUSEIPDB_DAILY=1000
RETENTION_DAYS=90   # how long analysed articles and sightings are kept
CACHE_TTL=3600      # seconds to cache provider answers
MAX_BULK=500        # max indicators per batch
HOST=127.0.0.1      # keep on localhost; there is no login on this app
PORT=5000

# ---- Deployment (see README) ----
STATE_DIR=              # writable folder for the database; leave blank locally
TRUST_PROXY=0           # number of reverse proxies in front (1 for Caddy or Render)
ALLOWED_NETS=           # only these client IPs/networks may use the app, e.g. 203.0.113.10,198.51.100.0/24
REQUIRE_ALLOWED_NETS=0  # set 1 on servers: refuse to start if ALLOWED_NETS is empty
NEVER_SEND_DOMAINS=     # your company domains, never sent to outside services, e.g. example.com,corp.example.com
NEVER_SEND_CIDRS=       # your own public IP ranges, never sent to outside services
DAILY_BUDGET=0          # max lookups per day across all users (0 = unlimited). Try 300.
DOMAIN=                 # VPS only: the hostname Caddy should get a certificate for
